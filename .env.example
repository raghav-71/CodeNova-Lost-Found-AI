# ====================================================================
# FINDIT AI — PRODUCTION & DEVELOPMENT ENVIRONMENT TEMPLATE
# "Lost something? Let's find it."
# ====================================================================

# --------------------------------------------------------------------
# 1. Backend Server Configuration (Private - Node.js Server Only)
# --------------------------------------------------------------------
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-findit-frontend.vercel.app
ALLOWED_ORIGINS=https://your-findit-frontend.vercel.app,http://localhost:5173
ALLOW_VERCEL_PREVIEWS=true

# --------------------------------------------------------------------
# 2. Supabase Cloud Configuration (Private - Server-Side Only)
# Project URL, Anon Key, and Admin Service Role Key
# --------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --------------------------------------------------------------------
# 3. Google Gemini AI Configuration (Private - Server-Side Only)
# Get your API key from https://aistudio.google.com/
# (If omitted, FindIt AI's deterministic campus AI fallback activates)
# --------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# --------------------------------------------------------------------
# 4. Frontend Client Environment Variables (Public - Browser Exposed)
# Only VITE_* variables are bundled into the client build
# --------------------------------------------------------------------
VITE_API_URL=https://your-findit-backend.onrender.com/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
